<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent template for vision_sidecar.py (NOT a root daemon).

  Substitute @HOME@ with the operator's home directory before install, e.g.:
    sed "s|@HOME@|$HOME|g" com.openmoxie.vision-sidecar.plist \
      > ~/Library/LaunchAgents/com.openmoxie.vision-sidecar.plist
  Then fix the clone path if it is not $HOME/openmoxie.

  This is a user agent (gui/<uid>), not a system daemon. Do not install it
  with sudo / into /Library/LaunchDaemons — that is the caption server's
  pattern (port 443) and is the wrong privilege for this process.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmoxie.vision-sidecar</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/openmoxie/venv/bin/python</string>
    <string>@HOME@/openmoxie/vision-sidecar/vision_sidecar.py</string>
    <!-- NO --resend-interval: periodic re-arm is a HEARTBEAT HAMMER.
         2026-08-28 incident: repeated LoggingStateUpdate(STOP)+EnableICModule
         (event-arm every ~10s + this resend) crash-looped the robot's XMOS
         audio subsystem and escalated to full watchdog REBOOTS. Arming is
         an event — once per connection ($SYS connect line, or first event
         seen from a not-yet-armed device) — never periodic. If suspend/wake
         ever closes the gate, add a targeted once-per-wake trigger, not a
         timer. -->
    <!-- Episode-bounded stall watchdog (NOT a heartbeat, NOT --resend-interval).
         Polls frame mtimes via these globs; if frames go stale while the
         device is RUNNING, at most 2 arms per stall episode. The arm
         counter resets ONLY when frames are observed actually flowing
         again — never on a timer alone. Distinct from the heartbeat-hammer
         this file already forbids: file-stat polling is a timer (reading
         a file is fine); messages to the robot are strictly event-driven. -->
    <string>--frames-glob</string>
    <string>@HOME@/openmoxie/caption/frames/fast_*.jpg,@HOME@/openmoxie/caption/frames/frame_*.jpg</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@/openmoxie/vision-sidecar</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/openmoxie/vision-sidecar/vision-sidecar.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/openmoxie/vision-sidecar/vision-sidecar.log</string>
</dict>
</plist>
