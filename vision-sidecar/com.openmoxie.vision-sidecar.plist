<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent template for vision_sidecar.py (NOT a root daemon).

  Substitute @HOME@ with the operator's home directory before install, e.g.:
    sed "s|@HOME@|$HOME|g" com.openmoxie.vision-sidecar.plist \
      > ~/Library/LaunchAgents/com.openmoxie.vision-sidecar.plist
  Then fix the clone path if it is not $HOME/openmoxie.

  This is a user agent (gui/<uid>), not a system daemon. Do not install it
  with sudo / into /Library/LaunchDaemons — that is the caption server's
  pattern (port 443) and is the wrong privilege for this process.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openmoxie.vision-sidecar</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/openmoxie/venv/bin/python</string>
    <string>@HOME@/openmoxie/vision-sidecar/vision_sidecar.py</string>
    <!-- resend safety-net: the $SYS connect-trigger fires on a fresh boot,
         but a wake-from-suspend keeps the same MQTT session (no new connect
         line), so a periodic re-arm keeps the capture gate open across
         sleep/wake. Idempotent; 60s is negligible traffic. -->
    <string>--resend-interval</string>
    <string>60</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@/openmoxie/vision-sidecar</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/openmoxie/vision-sidecar/vision-sidecar.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/openmoxie/vision-sidecar/vision-sidecar.log</string>
</dict>
</plist>
